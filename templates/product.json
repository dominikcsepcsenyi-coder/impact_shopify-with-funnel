t-family: 'Courier New', monospace;\n    font-size: 11px;\n    letter-spacing: 0.25em;\n    color: #888;\n    text-transform: uppercase;\n    margin-bottom: 18px;\n  }\n  .nv-sci__heading {\n    font-size: 28px;\n    font-weight: 300;\n    line-height: 1.35;\n    color: #ffffff;\n    margin-bottom: 28px;\n  }\n  .nv-sci__body {\n    font-size: 16px;\n    line-height: 1.85;\n    color: #aaa;\n  }\n  .nv-sci__body p + p { margin-top: 16px; }\n  .nv-sci__body strong { color: #ffffff; font-weight: 400; }\n\n  /* Chart animation */\n  .nv-fill { opacity:0; animation: nvFade 1.2s ease forwards .3s; }\n  .nv-line { stroke-dasharray:900; stroke-dashoffset:900; animation: nvDraw 2s ease forwards .5s; }\n  @keyframes nvFade { to { opacity:1 } }\n  @keyframes nvDraw { to { stroke-dashoffset:0 } }\n\n  @media (max-width: 768px) {\n    .nv-sci { padding: 56px 20px; }\n    .nv-sci__inner { grid-template-columns:1fr; gap:48px; }\n    .nv-sci__text { border-left:none; border-top:1px solid #222; padding-left:0; padding-top:40px; }\n  }\n</style>\n\n<section class=\"nv-sci\">\n  <div class=\"nv-sci__inner\">\n\n    <!-- CHART -->\n    <div>\n      <div class=\"nv-chart__label\">\n        Noctis WellnesLens™ —<br>\n        <em>Kékfény blokkolás 400–520nm</em>\n      </div>\n\n      <div class=\"nv-chart__svg-wrap\">\n        <svg viewBox=\"0 0 420 260\" xmlns=\"http://www.w3.org/2000/svg\" preserveAspectRatio=\"none\">\n          <defs>\n            <!-- Full visible spectrum colours -->\n            <linearGradient id=\"nv-spec\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"0%\">\n              <stop offset=\"0%\"   stop-color=\"#6633ff\" stop-opacity=\"1\"/>\n              <stop offset=\"12%\"  stop-color=\"#3399ff\" stop-opacity=\"1\"/>\n              <stop offset=\"28%\"  stop-color=\"#00ffaa\" stop-opacity=\"1\"/>\n              <stop offset=\"45%\"  stop-color=\"#aaff00\" stop-opacity=\"1\"/>\n              <stop offset=\"62%\"  stop-color=\"#ffdd00\" stop-opacity=\"1\"/>\n              <stop offset=\"78%\"  stop-color=\"#ff6600\" stop-opacity=\"1\"/>\n              <stop offset=\"100%\" stop-color=\"#cc1100\" stop-opacity=\"1\"/>\n            </linearGradient>\n\n            <!-- Red tint overlay for blocked zone -->\n            <linearGradient id=\"nv-redtint\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"0%\">\n              <stop offset=\"0%\"   stop-color=\"#cc0000\" stop-opacity=\"0.22\"/>\n              <stop offset=\"100%\" stop-color=\"#cc0000\" stop-opacity=\"0.05\"/>\n            </linearGradient>\n\n            <!-- Desaturate/dim blocked zone with dark overlay -->\n            <linearGradient id=\"nv-dim\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"0%\">\n              <stop offset=\"0%\"   stop-color=\"#0d0d0d\" stop-opacity=\"0.72\"/>\n              <stop offset=\"100%\" stop-color=\"#0d0d0d\" stop-opacity=\"0.38\"/>\n            </linearGradient>\n\n            <filter id=\"nv-glow\" x=\"-20%\" y=\"-20%\" width=\"140%\" height=\"140%\">\n              <feGaussianBlur stdDeviation=\"2.5\" result=\"b\"/>\n              <feMerge><feMergeNode in=\"b\"/><feMergeNode in=\"SourceGraphic\"/></feMerge>\n            </filter>\n          </defs>\n\n          <!-- Grid -->\n          <line x1=\"0\" y1=\"65\"  x2=\"420\" y2=\"65\"  stroke=\"#1e1e1e\" stroke-width=\"1\"/>\n          <line x1=\"0\" y1=\"130\" x2=\"420\" y2=\"130\" stroke=\"#1e1e1e\" stroke-width=\"1\"/>\n          <line x1=\"0\" y1=\"195\" x2=\"420\" y2=\"195\" stroke=\"#1e1e1e\" stroke-width=\"1\"/>\n          <line x1=\"0\" y1=\"260\" x2=\"420\" y2=\"260\" stroke=\"#1e1e1e\" stroke-width=\"1\"/>\n\n          <!-- SPECTRUM FILL — full colour, visible everywhere -->\n          <path class=\"nv-fill\"\n            d=\"M0,260 L0,235 C14,228 26,210 46,178 C68,142 78,92 100,52 C114,24 126,10 140,14 C156,19 168,62 184,98 C200,132 212,155 234,170 C258,185 280,188 304,184 C326,180 348,174 374,177 C394,179 408,182 420,184 L420,260 Z\"\n            fill=\"url(#nv-spec)\"\n            opacity=\"0.75\"\n          />\n\n          <!-- DIM overlay on blocked zone (left 38%) — makes it look \"filtered\" not invisible -->\n          <rect class=\"nv-fill\" x=\"0\" y=\"0\" width=\"160\" height=\"260\" fill=\"url(#nv-dim)\"/>\n\n          <!-- RED TINT on blocked zone — shows what's being blocked -->\n          <rect class=\"nv-fill\" x=\"0\" y=\"0\" width=\"160\" height=\"260\" fill=\"url(#nv-redtint)\"/>\n\n          <!-- Curve line — bright, visible -->\n          <path class=\"nv-line\"\n            d=\"M0,235 C14,228 26,210 46,178 C68,142 78,92 100,52 C114,24 126,10 140,14 C156,19 168,62 184,98 C200,132 212,155 234,170 C258,185 280,188 304,184 C326,180 348,174 374,177 C394,179 408,182 420,184\"\n            fill=\"none\"\n            stroke=\"rgba(255,255,255,0.55)\"\n            stroke-width=\"2.5\"\n          />\n\n          <!-- Divider at 520nm -->\n          <line x1=\"160\" y1=\"0\" x2=\"160\" y2=\"260\"\n            stroke=\"#ff4444\"\n            stroke-width=\"2\"\n            stroke-dasharray=\"5,4\"\n            filter=\"url(#nv-glow)\"\n            opacity=\"0.9\"\n          />\n\n          <!-- Labels inside chart -->\n          <!-- Blocked label -->\n          <rect x=\"8\" y=\"10\" width=\"118\" height=\"22\" rx=\"3\" fill=\"rgba(180,30,30,0.18)\" stroke=\"rgba(200,50,50,0.4)\" stroke-width=\"1\"/>\n          <text x=\"16\" y=\"25\" font-family=\"'Courier New',monospace\" font-size=\"9.5\" fill=\"#ff6666\" letter-spacing=\"1\">⬛ BLOKOLT</text>\n\n          <!-- 520nm label -->\n          <text x=\"165\" y=\"22\" font-family=\"'Courier New',monospace\" font-size=\"10\" fill=\"#ff5555\" opacity=\"0.9\">520nm</text>\n\n          <!-- Passed label -->\n          <rect x=\"170\" y=\"10\" width=\"100\" height=\"22\" rx=\"3\" fill=\"rgba(200,169,110,0.1)\" stroke=\"rgba(200,169,110,0.25)\" stroke-width=\"1\"/>\n          <text x=\"178\" y=\"25\" font-family=\"'Courier New',monospace\" font-size=\"9.5\" fill=\"#c8a96e\" letter-spacing=\"1\">ÁTENGEDETT</text>\n        </svg>\n      </div>\n\n      <div class=\"nv-chart__xaxis\">\n        <span>400nm</span>\n        <span>455nm</span>\n        <span>500nm</span>\n        <span>600nm</span>\n        <span>700nm</span>\n      </div>\n      <div class=\"nv-chart__note\">\n        Látható fény hullámhossza (nm)<br>\n        *Példa értékek — relatív fényenergia, környezettől függően változhat\n      </div>\n    </div>\n\n    <!-- TEXT -->\n    <div class=\"nv-sci__text\">\n      <div class=\"nv-sci__wave\">\n        <span></span><span></span><span></span><span></span><span></span>\n      </div>\n      <div class=\"nv-sci__eyebrow\">A tudomány</div>\n      <h2 class=\"nv-sci__heading\">A kékfény megzavarja a tested természetes ritmusát.</h2>\n      <div class=\"nv-sci__body\">\n        <p>A szemed retinájában speciális sejtek figyelik a fényt — ezek mondják meg az agyadnak, hogy nappal van-e vagy éjszaka. <strong>Ezek a sejtek pontosan a kékfényre érzékenyek</strong> — arra, amit a telefonod, laptopod és a LED izzók folyamatosan kibocsátanak.</p>\n        <p>Este, amikor képernyőt nézel, az agyad azt hiszi, még nappal van. <strong>Nem termel melatonint. Nem tudsz elaludni.</strong> Ha el is alszol, nem mély az alvásod — reggel fáradtabban kelsz, mint ahogy lefeküdtél.</p>\n        <p>A Noctis WellnesLens™ a 400–520nm tartományban szűri ki ezt a fényt. Az agyad megkapja a jelet: vége a napnak. <strong>A melatonin termelés elindul. Az alvás helyreáll.</strong></p>\n      </div>\n    </div>\n\n  </div>\n</section>",
