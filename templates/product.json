n          />\n\n          <!-- DIM overlay on blocked zone (left 38%) — makes it look \"filtered\" not invisible -->\n          <rect class=\"nv-fill\" x=\"0\" y=\"0\" width=\"160\" height=\"260\" fill=\"url(#nv-dim)\"/>\n\n          <!-- RED TINT on blocked zone — shows what's being blocked -->\n          <rect class=\"nv-fill\" x=\"0\" y=\"0\" width=\"160\" height=\"260\" fill=\"url(#nv-redtint)\"/>\n\n          <!-- Curve line — bright, visible -->\n          <path class=\"nv-line\"\n            d=\"M0,235 C14,228 26,210 46,178 C68,142 78,92 100,52 C114,24 126,10 140,14 C156,19 168,62 184,98 C200,132 212,155 234,170 C258,185 280,188 304,184 C326,180 348,174 374,177 C394,179 408,182 420,184\"\n            fill=\"none\"\n            stroke=\"rgba(255,255,255,0.55)\"\n            stroke-width=\"2.5\"\n          />\n\n          <!-- Divider at 520nm -->\n          <line x1=\"160\" y1=\"0\" x2=\"160\" y2=\"260\"\n            stroke=\"#ff4444\"\n            stroke-width=\"2\"\n            stroke-dasharray=\"5,4\"\n            filter=\"url(#nv-glow)\"\n            opacity=\"0.9\"\n          />\n\n          <!-- Labels inside chart -->\n          <!-- Blocked label -->\n          <rect x=\"8\" y=\"10\" width=\"118\" height=\"22\" rx=\"3\" fill=\"rgba(180,30,30,0.18)\" stroke=\"rgba(200,50,50,0.4)\" stroke-width=\"1\"/>\n          <text x=\"16\" y=\"25\" font-family=\"'Courier New',monospace\" font-size=\"9.5\" fill=\"#ff6666\" letter-spacing=\"1\">⬛ BLOKOLT</text>\n\n          <!-- 520nm label -->\n          <text x=\"165\" y=\"22\" font-family=\"'Courier New',monospace\" font-size=\"10\" fill=\"#ff5555\" opacity=\"0.9\">520nm</text>\n\n          <!-- Passed label -->\n          <rect x=\"170\" y=\"10\" width=\"100\" height=\"22\" rx=\"3\" fill=\"rgba(200,169,110,0.1)\" stroke=\"rgba(200,169,110,0.25)\" stroke-width=\"1\"/>\n          <text x=\"178\" y=\"25\" font-family=\"'Courier New',monospace\" font-size=\"9.5\" fill=\"#c8a96e\" letter-spacing=\"1\">ÁTENGEDETT</text>\n        </svg>\n      </div>\n\n      <div class=\"nv-chart__xaxis\">\n        <span>400nm</span>\n        <span>455nm</span>\n        <span>500nm</span>\n        <span>600nm</span>\n        <span>700nm</span>\n      </div>\n      <div class=\"nv-chart__note\">\n        Látható fény hullámhossza (nm)<br>\n        *Példa értékek — relatív fényenergia, környezettől függően változhat\n      </div>\n    </div>\n\n    <!-- TEXT -->\n    <div class=\"nv-sci__text\">\n      <div class=\"nv-sci__wave\">\n        <span></span><span></span><span></span><span></span><span></span>\n      </div>\n      <div class=\"nv-sci__eyebrow\">A tudomány</div>\n      <h2 class=\"nv-sci__heading\">A kékfény megzavarja a tested természetes ritmusát.</h2>\n      <div class=\"nv-sci__body\">\n        <p>A szemed retinájában speciális sejtek figyelik a fényt — ezek mondják meg az agyadnak, hogy nappal van-e vagy éjszaka. <strong>Ezek a sejtek pontosan a kékfényre érzékenyek</strong> — arra, amit a telefonod, laptopod és a LED izzók folyamatosan kibocsátanak.</p>\n        <p>Este, amikor képernyőt nézel, az agyad azt hiszi, még nappal van. <strong>Nem termel melatonint. Nem tudsz elaludni.</strong> Ha el is alszol, nem mély az alvásod — reggel fáradtabban kelsz, mint ahogy lefeküdtél.</p>\n        <p>A Noctis WellnesLens™ a 400–520nm tartományban szűri ki ezt a fényt. Az agyad megkapja a jelet: vége a napnak. <strong>A melatonin termelés elindul. Az alvás helyreáll.</strong></p>\n      </div>\n    </div>\n\n  </div>\n</section>",
